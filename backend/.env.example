# ── MT Pocket Backend Environment Configuration ──────────────────────────────

# ── Server & Environment
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# ── Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=mtpocket

# ── Authentication & JWT Secrets
JWT_ACCESS_SECRET=your-secure-access-secret-key-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Email Service (Resend)
EMAIL_PROVIDER=resend
EMAIL_FROM=notifications@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SUPPORT_EMAIL=support@yourdomain.com

# ── Cloudinary (Private & Authenticated Document / Selfie Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# ── SMS / OTP Provider (Optional / Production)
# Use 'stub' for development, 'msg91' for live SMS
SMS_PROVIDER=stub
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=MTPKTT
