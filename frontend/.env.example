# ── Frontend Environment Variables ──────────────────────────────────────────
# Used by Vite during build and local dev.
# In Vercel, add these under Project Settings -> Environment Variables.

# Point to your deployed backend API URL (with /api suffix)
VITE_API_URL=https://your-backend-api.com/api

# ── Firebase Client SDK (Phone OTP Authentication) ───────────────────────────
# Get these from Firebase Console -> Project Settings -> General -> Your apps (Web app)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
